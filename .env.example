# ==============================================================================
# InsightRAG Configuration Environment Template
# Copy this file to .env and fill in the required values.
# NEVER commit .env with real credentials to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_NAME=InsightRAG
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (PostgreSQL with pgvector)
POSTGRES_USER=insightrag_user
POSTGRES_PASSWORD=insightrag_secret_change_in_production
POSTGRES_DB=insightrag_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://insightrag_user:insightrag_secret_change_in_production@localhost:5432/insightrag_db

# LLM Provider Configuration (OpenAI-compatible)
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# Embedding Configuration
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=your-api-key-here
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Ingestion & Chunking Defaults
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50

# Retrieval & Reranker Configuration
DEFAULT_TOP_K=5
HYBRID_RETRIEVAL_ALPHA=0.5
RRF_K=60
RERANKER_PROVIDER=cross-encoder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=5
CANDIDATE_POOL_SIZE=20

